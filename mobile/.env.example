# Copy to mobile/.env for local development. Never commit the real file.
#
# All variables here MUST be prefixed EXPO_PUBLIC_ — Metro inlines them
# directly into the client bundle at build time, so nothing secret belongs
# here. The Supabase anon key is designed by Supabase to be public/
# embeddable (Row Level Security is what actually protects data, not
# keeping this key hidden) — see docs/AUTHENTICATION_SETUP.md.
# The mobile app must NEVER receive the Supabase service_role key, the
# database password, or the JWT signing secret — those stay backend-only
# (backend/.env.example).

# --- Backend API ---
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Supabase project coordinates (Phase 3: Auth) ---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
