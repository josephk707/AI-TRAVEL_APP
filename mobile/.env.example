# Copy to mobile/.env for local development. Never commit the real file.
# Only EXPO_PUBLIC_-prefixed vars are ever bundled into client code — see
# docs/DEPLOYMENT_PLAN.md §4. Never put a server-side secret here.

# Backend API base URL. Point this at your local FastAPI dev server, or a
# LAN IP (not "localhost") when testing on a physical device via Expo Go.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Reserved for Phase 3 (Auth) — Supabase publishable coordinates only,
# never the service-role key, which stays backend-only. ---
# EXPO_PUBLIC_SUPABASE_URL=
# EXPO_PUBLIC_SUPABASE_ANON_KEY=
