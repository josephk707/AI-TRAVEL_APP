# Copy to backend/.env for local development. Never commit the real file.
# Placeholders only — see docs/DEPLOYMENT_PLAN.md §4 (Secrets Management).

# --- App identity ---
APP_NAME=TC-SO1 Backend
APP_VERSION=0.1.0
ENVIRONMENT=development

# --- CORS (comma-separated origins) ---
CORS_ALLOW_ORIGINS=http://localhost:19006,http://localhost:8081

# --- Logging ---
LOG_LEVEL=INFO

# --- Database connection (Phase 1: optional; leave unset if no Supabase
# project exists yet in this environment — readiness will report
# "not_configured" rather than failing). Provisioned for real in Phase 2. ---
DATABASE_URL=

# --- Supabase project coordinates (Phase 3+: Auth) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Supabase Auth JWT verification (Phase 3) ---
# No secret variable needed here. This project verifies access tokens via
# Supabase's public JWKS endpoint ({SUPABASE_URL}/auth/v1/.well-known/jwks.json),
# not a shared HS256 secret — see app/core/security.py's module docstring
# and docs/AUTHENTICATION_SETUP.md §4 for why. SUPABASE_URL above is all
# that's required; without it, get_current_user() fails closed with 401
# rather than trusting an unverified token.

# --- Maps & Navigation (F6) ---
# A Google Maps Platform API key with the "Places API (New)" enabled and
# billing configured on the project. Server-side only — never sent to the
# mobile client. When unset, GET /v1/pois/search degrades to returning
# only cached/curated results (meta.degraded_mode=true) rather than
# failing; GET /v1/pois/nearby and /v1/pois/{poi_id} are unaffected (they
# never call this API — see app/services/poi_service.py).
GOOGLE_MAPS_API_KEY=

# --- Places, second provider (Maps Integration phase) ---
# Geoapify Places API key (https://www.geoapify.com/places-api/) —
# server-side only, never sent to the mobile client. Used for
# location-based ("nearby") place discovery only, per
# app/services/geoapify_places_client.py's module docstring — Geoapify's
# Places API has no free-text search (that needs Geoapify's separate
# Geocoding API, not yet authorized/configured). When unset,
# GET /v1/pois/nearby degrades to cache/curated-only results
# (meta.degraded_mode=true) rather than failing.
GEOAPIFY_API_KEY=

# --- Weather (Phase 6 — F3 outdoor-activity flagging, H7 fix) ---
# OpenWeatherMap API key. Server-side only. When unset, the weather
# business-rule step is skipped (items are not flagged) rather than the
# itinerary pipeline failing — see app/services/weather_client.py.
# NOTE: this is a SEPARATE integration from GET /v1/weather (Maps
# Integration phase), which uses Open-Meteo and needs no key at all — see
# app/services/open_meteo_client.py's module docstring.
WEATHER_API_KEY=

# --- AI / LLM Gateway (Phase 6 — F3/F4/F5, AI_ARCHITECTURE.md §1) ---
# Google Gemini is the selected provider. Server-side only — never sent to
# the mobile client, never logged, never committed. When unset, every AI
# pipeline degrades to its documented fallback (curated template / plain
# 503) rather than crashing — see app/services/ai/factory.py.
GEMINI_API_KEY=
LLM_PROVIDER=gemini

# --- Safety/SOS trusted-contact email (Phase 8 — F21) ---
# Plain SMTP relay credentials (any provider). Server-side only. When
# unset, SOS still records the event and dispatches the real Expo push
# notification; only the non-app-user trusted-contact email leg degrades
# (never a hard failure) — see app/services/email_client.py. SMS is not
# implemented (no commercial provider was ever decided — see
# docs/PHASE_STATUS.md's Phase 8 section).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
